[Unit]
Description=MQT Core compiler benchmark history

[Service]
Type=oneshot
WorkingDirectory=%h/mqt-core-benchmarks
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%h/.config/mqt-core-benchmarks/worker.env
# A resumed calendar timer must not start measurements on a weekday.
ExecCondition=/usr/bin/env TZ=Europe/Berlin /bin/sh -c 'test "$$(date +%%u)" -ge 6'
ExecStart=%h/.local/bin/uv run --no-sync python -m benchmarks.runner batch --settings %h/.config/mqt-core-benchmarks/worker.json --publish
TimeoutStartSec=36h
