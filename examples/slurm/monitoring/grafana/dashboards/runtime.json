{
  "uid": "mqt-runtime",
  "title": "MQT Runtime",
  "description": "Slurm scheduling, resource allocation and accounting in the MQT playground.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "What this view measures",
      "type": "text",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "options": {
        "mode": "markdown",
        "content": "Live Slurm jobs, nodes and CPU allocations, with persistent job history below. Allocation is **not actual CPU or QPU usage**. Missing samples remain unavailable."
      }
    },
    {
      "id": 2,
      "title": "Metrics endpoint health",
      "description": "Whether Prometheus can scrape itself and each Slurm endpoint. A Prometheus outage prevents this panel from loading.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"prometheus|slurm_(jobs|nodes|partitions|scheduler)\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "color": "red" },
                "1": { "text": "Up", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "title": "Running jobs by partition",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_partition_jobs_running{job=\"slurm_partitions\"}",
          "legendFormat": "{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Pending jobs by partition",
      "description": "Jobs waiting in each partition, including dependency, resource and policy waits.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_partition_jobs_pending{job=\"slurm_partitions\"}",
          "legendFormat": "{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Registered nodes and states",
      "description": "State flags can overlap; do not add these series together.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_nodes{job=\"slurm_nodes\"}",
          "legendFormat": "Registered"
        },
        {
          "refId": "B",
          "expr": "slurm_nodes_idle{job=\"slurm_nodes\"}",
          "legendFormat": "Idle"
        },
        {
          "refId": "C",
          "expr": "slurm_nodes_alloc{job=\"slurm_nodes\"}",
          "legendFormat": "Allocated"
        },
        {
          "refId": "D",
          "expr": "slurm_nodes_mixed{job=\"slurm_nodes\"}",
          "legendFormat": "Mixed"
        },
        {
          "refId": "E",
          "expr": "slurm_nodes_down{job=\"slurm_nodes\"}",
          "legendFormat": "Down"
        },
        {
          "refId": "F",
          "expr": "slurm_nodes_drain{job=\"slurm_nodes\"}",
          "legendFormat": "Drain flag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "CPU allocation",
      "description": "Scheduled CPU allocations and configured CPUs across registered nodes, not CPU utilization.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(slurm_node_cpus_alloc{job=\"slurm_nodes\"})",
          "legendFormat": "Allocated CPUs"
        },
        {
          "refId": "B",
          "expr": "sum(slurm_node_cpus{job=\"slurm_nodes\"})",
          "legendFormat": "Configured CPUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "CPU allocation by partition",
      "description": "Scheduled CPU allocations and configured CPUs in each partition. Nodes can belong to more than one partition.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_partition_nodes_cpus_alloc{job=\"slurm_partitions\"}",
          "legendFormat": "{{partition}} allocated"
        },
        {
          "refId": "B",
          "expr": "slurm_partition_cpus{job=\"slurm_partitions\"}",
          "legendFormat": "{{partition}} configured"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Last scheduler cycle duration",
      "description": "Duration of the most recent scheduling cycle, converted from microseconds. This is not job execution or queue time.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_schedule_cycle_last{job=\"slurm_scheduler\"} / 1000000",
          "legendFormat": "Main scheduler"
        },
        {
          "refId": "B",
          "expr": "slurm_bf_cycle_last{job=\"slurm_scheduler\"} / 1000000",
          "legendFormat": "Backfill scheduler"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "noValue": "No data" },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Job accounting",
      "description": "Playground jobs selected by the dashboard time range, including short jobs between scrapes. Elapsed time covers the whole job. Exit code is status:signal; blank values are not yet available.",
      "type": "table",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 9 },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "slurm-accounting"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/slurmdb/v0.0.44/jobs/",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "start_time",
                "value": "${__timeFrom:date:seconds}"
              },
              {
                "key": "end_time",
                "value": "${__timeTo:date:seconds}"
              }
            ]
          },
          "root_selector": "$count(errors) > 0 ? $error(\"Slurm accounting request failed: \" & $string(errors)) : [jobs.{\"job_id\": job_id, \"name\": name, \"partition\": partition, \"state\": $join(state.current, \", \"), \"exit_code\": (exit_code.return_code.set or exit_code.signal.id.set) ? ($string(exit_code.return_code.set ? exit_code.return_code.number : 0) & \":\" & $string(exit_code.signal.id.set ? exit_code.signal.id.number : 0)) : null, \"start\": time.start > 0 ? time.start : null, \"end\": time.end > 0 ? time.end : null, \"elapsed\": time.elapsed, \"cpus\": tres.allocated[type = \"cpu\"][0].count, \"licenses\": $join(tres.allocated[type = \"license\"].(name & \"=\" & $string(count)), \", \")}]",
          "columns": [
            { "selector": "job_id", "text": "Job ID", "type": "number" },
            { "selector": "name", "text": "Name", "type": "string" },
            { "selector": "partition", "text": "Partition", "type": "string" },
            { "selector": "state", "text": "State", "type": "string" },
            { "selector": "exit_code", "text": "Exit code", "type": "string" },
            {
              "selector": "start",
              "text": "Start",
              "type": "timestamp_epoch_s"
            },
            { "selector": "end", "text": "End", "type": "timestamp_epoch_s" },
            { "selector": "elapsed", "text": "Elapsed", "type": "number" },
            { "selector": "cpus", "text": "CPUs", "type": "number" },
            { "selector": "licenses", "text": "Licenses", "type": "string" }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Job ID": 0,
              "State": 1,
              "Exit code": 2,
              "Elapsed": 3,
              "CPUs": 4,
              "Licenses": 5,
              "Partition": 6,
              "Name": 7,
              "Start": 8,
              "End": 9
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "noValue": "—" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Elapsed" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "Job ID" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Job ID", "desc": true }]
      }
    }
  ]
}
